DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kotlin_up?schema=public"

# Mentor IA: Gemini es el proveedor predeterminado. Genera una clave en Google AI Studio.
# No pongas esta clave en el navegador, el repositorio ni la compartas por chat.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Alternativa opcional si ya cuentas con una clave de OpenAI.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-astra"

# Endpoint oficial de ejecución del Kotlin Playground; se puede cambiar por un servidor propio.
KOTLIN_PLAYGROUND_RUN_URL="https://api.kotlinlang.org/api/2.4.21/compiler/run"
KOTLIN_COMPILER_VERSION="2.4.21"

# URL completa del worker que compila/renderiza Compose en un contenedor aislado.
# El worker recibe POST JSON { code, levelId } y responde { imageUrl, logs }.
COMPOSE_PREVIEW_URL="http://localhost:9000/api/preview"
